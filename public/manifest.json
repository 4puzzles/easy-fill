{
  "manifest_version": 3,

  "name": "Easy Fill",

  "version": "2.0.0",

  "version_name": "2.0.0-alpha.3",
  
  "action": {
    "default_icon": {
      "16": "img/icon.png",
      "32": "img/icon.png",
      "48": "img/icon.png",
      "128": "img/icon.png"
    },
    "default_title": "__MSG_pluginDesc__"
  },

  "default_locale": "zh_CN",

  "description": "__MSG_pluginDesc__",

  "icons": {
    "16": "img/icon.png",
    "32": "img/icon.png",
    "48": "img/icon.png",
    "128": "img/icon.png"
  },

  "content_scripts": [
    {
      "matches": [ 
        "http://jw.gdbtu.edu.cn/wjstgdfw/cjlr.lrxscj.fkcaskbjlrcj_input.jsp*",
        "http://218.15.245.162:9087/wjstgdfw/cjlr.lrxscj.fkcaskbjlrcj_input.jsp*",
        "http://172.18.100.39:9087/wjstgdfw/cjlr.lrxscj.fkcaskbjlrcj_input.jsp*"
      ],
      "js": [ "js/content-script.js" ],
      "css": ["css/inject.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],

  "homepage_url": "https://github.com/4puzzles/easy-fill",
  
  "web_accessible_resources": [
    {
      "resources": [ "js/inject.js" ],
      "matches": [ 
        "http://jw.gdbtu.edu.cn/*",
        "http://218.15.245.162:9087/*",
        "http://172.18.100.39:9087/*"
      ]
    }
  ]
}
